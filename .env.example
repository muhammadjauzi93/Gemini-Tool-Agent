# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional (defaults shown) ----------------------------------------------
# Gemini model used for every request.
GEMINI_MODEL=gemini-3.8-flash
# Maximum tool-call rounds per user message.
MAX_TOOL_STEPS=10
# Print [tool] trace lines in the terminal (true/false).
SHOW_TOOL_CALLS=true

# --- Other providers (not used by the agent; for experiments) ---------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
